---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>Kirk D. Brown — Blog</title>
    <subtitle>Notes on software engineering and AI-assisted development.</subtitle>
    <link href="https://kdborg.com/blog/feed.xml" rel="self" />
    <link href="https://kdborg.com/blog/" />
    <id>https://kdborg.com/blog/</id>
    {% set posts = collections.post | reverse %}
    {% if posts.length %}<updated>{{ posts[0].date | rfc3339 }}</updated>{% endif %}
    <author>
        <name>Kirk D. Brown</name>
        <email>kdborg@gmail.com</email>
    </author>
    {% for post in posts %}
    <entry>
        <title>{{ post.data.title }}</title>
        <link href="https://kdborg.com{{ post.url }}" />
        <id>https://kdborg.com{{ post.url }}</id>
        <updated>{{ post.date | rfc3339 }}</updated>
        {% if post.data.description %}<summary>{{ post.data.description }}</summary>{% endif %}
        <content type="html">{{ post.templateContent | e }}</content>
    </entry>
    {% endfor %}
</feed>
